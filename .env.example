# Jira. AGL's instance allows anonymous reads, so JIRA_EMAIL / JIRA_API_TOKEN can stay empty.
# Set them (Atlassian account email + API token) only for an instance that requires auth.
JIRA_BASE_URL=https://lf-automotivelinux.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# OpenAI, used to draft the report narrative. Not needed with --no-llm.
OPENAI_API_KEY=
